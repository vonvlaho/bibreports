---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import { entries, findReport, getEntryKeywords, getEntryPeople, getEntryPlaces, getReportEntries } from '../../lib/data';

export function getStaticPaths() {
  return entries.map((entry) => ({ params: { id: String(entry.id) }, props: { entry } }));
}

const { entry } = Astro.props;
const report = findReport(entry.reportId);
const keywords = getEntryKeywords(entry);
const people = getEntryPeople(entry);
const places = getEntryPlaces(entry);
const reportEntries = report ? getReportEntries(report) : [];
const entryIndex = reportEntries.findIndex((reportEntry) => reportEntry.id === entry.id);
const previousEntry = entryIndex > 0 ? reportEntries[entryIndex - 1] : undefined;
const nextEntry = entryIndex >= 0 && entryIndex < reportEntries.length - 1 ? reportEntries[entryIndex + 1] : undefined;
---

<BaseLayout title={entry.title || entry.fullTitle}>
  <PageHeader
    title={`Eintrag ${entry.entryNo}`}
    eyebrow={report ? `Bericht ${report.year}` : undefined}
    description={report ? report.title : undefined}
    meta={[entry.type, entry.publicationYear].filter(Boolean)}
    className="entry-context"
  >
    {report && <a class="context-link" href={`/reports/${report.id}/`}>Zum Bericht {report.year}</a>}
  </PageHeader>

  <article class="container section reading">
    {keywords.length > 0 && (
      <ul class="tag-list">
        {keywords.map((keyword) => <li><a class="tag" href={`/keywords/${keyword.id}/`}>{keyword.name}</a></li>)}
      </ul>
    )}
    <h2>{entry.fullTitle}</h2>
    {entry.abstract && <p>{entry.abstract}</p>}
    {people.length > 0 && (
      <>
        <h3>Personen</h3>
        <ul>
          {people.map((person) => <li><a href={`/people/${person.id}/`}>{person.givenName} {person.familyName}</a> <span class="muted">{person.roleLabel}</span></li>)}
        </ul>
      </>
    )}
    {places.length > 0 && (
      <>
        <h3>Orte</h3>
        <ul>
          {places.map((place) => <li><a href={`/places/${place.id}/`}>{place.name}</a></li>)}
        </ul>
      </>
    )}
    {(previousEntry || nextEntry) && (
      <nav class="entry-nav" aria-label="Eintragsnavigation">
        {previousEntry ? <a href={`/entries/${previousEntry.id}/`}>Vorheriger Eintrag</a> : <span />}
        {nextEntry ? <a href={`/entries/${nextEntry.id}/`}>Nächster Eintrag</a> : <span />}
      </nav>
    )}
  </article>
</BaseLayout>
