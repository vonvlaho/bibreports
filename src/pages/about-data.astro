---
import BaseLayout from '../layouts/BaseLayout.astro';
import { entries, keywords, people, places, reports } from '../lib/data';
---

<BaseLayout title="Daten">
  <section class="container section panel">
    <h1>Daten</h1>
    <p>
      Die statische Version erzeugt alle Seiten aus den XML-Dateien in <code>database/data</code>. CSV-Dateien bleiben als
      Download-Artefakte im öffentlichen Build erhalten.
    </p>
  </section>
  <section class="container section grid">
    <div class="card"><strong>{reports.length}</strong><br />Berichte</div>
    <div class="card"><strong>{entries.length}</strong><br />Einträge</div>
    <div class="card"><strong>{keywords.length}</strong><br />Registerbegriffe</div>
    <div class="card"><strong>{people.length}</strong><br />Personen</div>
    <div class="card"><strong>{places.length}</strong><br />Orte</div>
  </section>
  <section class="container section">
    <h2>CSV-Exporte</h2>
    <div class="link-list">
      <a href="/berichte.csv"><strong>Bibliographie</strong><span class="muted">Alle Einträge</span></a>
      <a href="/keywords.csv"><strong>Registerbegriffe</strong><span class="muted">Einträge und Schlagworte</span></a>
      <a href="/people.csv"><strong>Personen</strong><span class="muted">Einträge, Personen und Rollen</span></a>
      <a href="/places.csv"><strong>Publikationsorte</strong><span class="muted">Einträge und Orte</span></a>
    </div>
  </section>
</BaseLayout>
