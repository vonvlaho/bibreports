---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SearchForm from '../../components/SearchForm.astro';
import { keywords } from '../../lib/data';
---

<BaseLayout title="Register">
  <section class="container section search-panel compact">
    <h1>Register</h1>
    <SearchForm label="Website durchsuchen" placeholder="Website durchsuchen" />
    <p class="muted">{keywords.length} Begriffe</p>
  </section>
  <section class="container section">
    <ul class="index-list">
      {keywords.map((keyword) => <li><a href={`/keywords/${keyword.id}/`}>{keyword.name}</a> <span class="muted">{keyword.entryIds.length}</span></li>)}
    </ul>
  </section>
</BaseLayout>
