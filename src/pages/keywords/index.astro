---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AlphabetNav from '../../components/AlphabetNav.astro';
import PageHeader from '../../components/PageHeader.astro';
import RegisterFilter from '../../components/RegisterFilter.astro';
import { groupEntriesByYear, keywords } from '../../lib/data';
import { createAnchorFactory } from '../../lib/register';

const anchorFor = createAnchorFactory('register');
---

<BaseLayout title="Register">
  <PageHeader
    title="Gesamtregister"
    eyebrow="Register"
    description="Registerbegriffe mit jahresbezogenen Verweisen auf die bibliographischen Einträge."
    className="register-tools"
  >
    <RegisterFilter label="Register durchsuchen" placeholder="Registereintrag" countLabel="Registerbegriffe" />
    <AlphabetNav items={keywords} getLabel={(item: any) => item.name} targetPrefix="register" />
  </PageHeader>
  <section class="container section content">
    <dl class="register-list">
      {
        keywords.map((keyword) => (
          <div id={anchorFor(keyword.name)} data-register-row data-register-text={keyword.name}>
            <dt>
              <strong><a href={`/keywords/${keyword.id}`}>{keyword.name}</a></strong>
            </dt>
            {groupEntriesByYear(keyword.entryIds).map((group) => (
              <dd>
                {group.year}:{' '}
                {group.entries.map((entry, index) => (
                  <>
                    <a href={`/entries/${entry.id}`}>{entry.entryNo}</a>{index < group.entries.length - 1 ? ', ' : '.'}
                  </>
                ))}
              </dd>
            ))}
          </div>
        ))
      }
    </dl>
  </section>
</BaseLayout>
