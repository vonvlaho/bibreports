---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { groupEntriesByYear, keywords } from '../../lib/data';

export function getStaticPaths() {
  return keywords.map((keyword) => ({ params: { id: String(keyword.id) }, props: { keyword } }));
}

const { keyword } = Astro.props;
const groups = groupEntriesByYear(keyword.entryIds);
---

<BaseLayout title={keyword.name}>
  <section class="container section panel">
    <h1>{keyword.name}</h1>
    <p class="muted">{keyword.entryIds.length} verknüpfte Einträge</p>
  </section>
  <section class="container section">
    {groups.map((group) => (
      <section class="section">
        <h2>{group.year}</h2>
        <ul class="list">
          {group.entries.map((entry) => <li><a href={`/entries/${entry.id}/`}>{entry.fullTitle}</a></li>)}
        </ul>
      </section>
    ))}
  </section>
</BaseLayout>
