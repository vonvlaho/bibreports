---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import { groupEntriesByYear, keywords } from '../../lib/data';

export function getStaticPaths() {
  return keywords.map((keyword) => ({ params: { id: String(keyword.id) }, props: { keyword } }));
}

const { keyword } = Astro.props;
const groups = groupEntriesByYear(keyword.entryIds);
---

<BaseLayout title={keyword.name}>
  <PageHeader title={keyword.name} eyebrow="Registerbegriff" meta={[`${keyword.entryIds.length} verknüpfte Einträge`]} />
  <section class="container section">
    {groups.map((group) => (
      <section class="year-group">
        <h2>{group.year}</h2>
        <ul class="list">
          {group.entries.map((entry) => <li><a href={`/entries/${entry.id}/`}>{entry.fullTitle}</a></li>)}
        </ul>
      </section>
    ))}
  </section>
</BaseLayout>
