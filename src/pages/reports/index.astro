---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import { reports } from '../../lib/data';
---

<BaseLayout title="Berichte">
  <PageHeader
    title="Berichte"
    eyebrow="Bestand"
    description="Jahresbände der bibliographischen Berichte mit direktem Zugriff auf Einträge und Register."
  />
  <section class="container section content">
    <div class="report-grid">
      {
        reports.map((report) => (
          <a class="report-card" href={`/reports/${report.id}/`}>
            {report.cover && <img src={`/img/${report.cover}`} alt="" loading="lazy" />}
            <span>
              <strong>Bericht {report.year}</strong>
              <span class="report-card-title">{report.title}</span>
              <span class="muted">{report.entryIds.length} Einträge</span>
            </span>
          </a>
        ))
      }
    </div>
  </section>
</BaseLayout>
