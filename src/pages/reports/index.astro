---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { reports } from '../../lib/data';
---

<BaseLayout title="Berichte">
  <section class="container section">
    <h1>Berichte</h1>
    <div class="report-list">
      {
        reports.map((report) => (
          <a class="report-row" href={`/reports/${report.id}/`}>
            {report.cover && <img src={`/img/${report.cover}`} alt="" loading="lazy" />}
            <span>
              <strong>{report.title} {report.year}</strong>
              <span class="muted">{report.entryIds.length} Eintraege</span>
            </span>
          </a>
        ))
      }
    </div>
  </section>
</BaseLayout>
