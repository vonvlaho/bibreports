---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import AlphabetNav from '../../../components/AlphabetNav.astro';
import PageHeader from '../../../components/PageHeader.astro';
import RegisterFilter from '../../../components/RegisterFilter.astro';
import { getEntries, getReportEntries, getEntryKeywords, reports } from '../../../lib/data';

export function getStaticPaths() {
  return reports.map((report) => ({ params: { id: String(report.id) }, props: { report } }));
}

const { report } = Astro.props;
const grouped = new Map();
for (const entry of getReportEntries(report)) {
  for (const keyword of getEntryKeywords(entry)) {
    grouped.set(keyword.id, { keyword, entryIds: [...(grouped.get(keyword.id)?.entryIds ?? []), entry.id] });
  }
}
const rows = [...grouped.values()].sort((a, b) => a.keyword.name.localeCompare(b.keyword.name, 'de'));
const initialFor = (value: string): string => {
  const initial = value.trim().charAt(0).toLocaleUpperCase('de');
  const replacements: Record<string, string> = { Ä: 'A', Ö: 'O', Ü: 'U' };
  return replacements[initial] ?? initial;
};
const seenInitials = new Set<string>();
const anchorFor = (value: string): string | undefined => {
  const initial = initialFor(value);
  if (!/^[A-Z]$/.test(initial) || seenInitials.has(initial)) {
    return undefined;
  }
  seenInitials.add(initial);
  return `report-register-${initial}`;
};
---

<BaseLayout title={`Register ${report.year}`}>
  <PageHeader
    title={`Register ${report.year}`}
    eyebrow={`Bericht ${report.year}`}
    description={report.title}
    className="register-tools"
  >
    <RegisterFilter label="Register durchsuchen" placeholder="Registereintrag" countLabel="Registerbegriffe" />
    <AlphabetNav items={rows} getLabel={(item: any) => item.keyword.name} targetPrefix="report-register" />
  </PageHeader>
  <section class="container section content">
    <dl class="register-list">
      {
        rows.map(({ keyword, entryIds }) => (
          <div id={anchorFor(keyword.name)} data-register-row data-register-text={keyword.name}>
            <dt><strong>{keyword.name}</strong></dt>
            <dd>
              {getEntries(entryIds).map((entry, index) => (
                <>
                  <a href={`/entries/${entry.id}`}>{entry.entryNo}</a>{index < entryIds.length - 1 ? ', ' : '.'}
                </>
              ))}
            </dd>
          </div>
        ))
      }
    </dl>
  </section>
</BaseLayout>
