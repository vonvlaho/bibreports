---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHeader from '../../../components/PageHeader.astro';
import { getReportEntries, reports } from '../../../lib/data';

export function getStaticPaths() {
  return reports.map((report) => ({ params: { id: String(report.id) }, props: { report } }));
}

const { report } = Astro.props;
const entries = getReportEntries(report);
---

<BaseLayout title={`${report.title} ${report.year}`}>
  <PageHeader
    title={`Bericht ${report.year}`}
    eyebrow="Jahresband"
    description={report.title}
    meta={[
      report.editor ? `Herausgegeben vom ${report.editor}` : '',
      report.publisher,
      `${entries.length} Einträge`,
    ].filter(Boolean)}
    className="report-header"
  >
    <nav class="nav-links" aria-label="Berichtsregister">
      <a href={`/reports/${report.id}/keywords`}>Register</a>
      <a href={`/reports/${report.id}/people`}>Personen</a>
      <a href={`/reports/${report.id}/places`}>Orte</a>
    </nav>
  </PageHeader>
  <section class="container section">
    <ol class="entry-list">
      {
        entries.map((entry) => (
          <li>
            <a href={`/entries/${entry.id}`}><strong>{entry.entryNo}</strong> {entry.fullTitle}</a>
          </li>
        ))
      }
    </ol>
  </section>
</BaseLayout>
