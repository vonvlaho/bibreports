---
import BaseLayout from '../layouts/BaseLayout.astro';
import MetricGrid from '../components/MetricGrid.astro';
import SearchForm from '../components/SearchForm.astro';
import { entries, keywords, people, places, reports } from '../lib/data';

const metrics = [
  { label: 'Berichte', value: reports.length },
  { label: 'Einträge', value: entries.length },
  { label: 'Registerbegriffe', value: keywords.length },
  { label: 'Personen', value: people.length },
  { label: 'Publikationsorte', value: places.length },
];
---

<BaseLayout isHome>
  <section class="container section home-workbench">
    <div class="home-workbench-header">
      <div>
        <p class="eyebrow">Recherche</p>
        <h2>Bestand durchsuchen</h2>
      </div>
      <nav class="quick-links home-links" aria-label="Startnavigation">
        <a href="/reports/">Berichte</a>
        <a href="/keywords/">Register</a>
        <a href="/places/">Publikationsorte</a>
        <a href="/people/">Personenverzeichnis</a>
        <a href="/analytics/">Analyse</a>
      </nav>
    </div>
    <SearchForm label="Website durchsuchen" placeholder="Website durchsuchen" />
    <MetricGrid metrics={metrics} />
  </section>

  <section class="container section prose home-background">
    <h2 id="Hintergrund">Hintergrund</h2>
    <p>
      Eine offizielle Bibliographie der musikwissenschaftlichen Schriften der DDR erschien als selbständige Publikation erstmals
      öffentlich mit dem Bericht über die Musikwissenschaftlichen Arbeiten der Deutschen Demokratischen Republik 1966. Seit Anfang
      der 1960er Jahre arbeitete man am Zentralinstitut bereits an einer Lochkartei zur systematischen Erfassung dieser
      Bibliographie seit 1945. Mit dem Bericht über die musikwissenschaftlichen Arbeiten erschien jedoch erstmals ein Verzeichnis
      der aktuellsten Publikationen.
    </p>
  </section>
</BaseLayout>
