---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import SearchForm from '../components/SearchForm.astro';

const query = Astro.url.searchParams.get('search') ?? '';
---

<BaseLayout title="Suche">
  <PageHeader
    title="Suche"
    eyebrow="Recherche"
    description="Durchsucht Einträge, Registerbegriffe, Personen und Ortsseiten im statischen Bestand."
    className="search-panel"
  >
    <SearchForm label="Website durchsuchen" placeholder="Neue Suchanfrage" value={query} />
  </PageHeader>
  <section class="container section search-results-section">
    <div id="search-status" class="muted">{query ? 'Suchindex wird geladen ...' : 'Bitte geben Sie eine Suchanfrage ein.'}</div>
    <div id="search-results"></div>
  </section>

  <script is:inline>
    (() => {
      const query = new URLSearchParams(window.location.search).get('search') || '';
      const status = document.querySelector('#search-status');
      const results = document.querySelector('#search-results');
      const input = document.querySelector('#site-search');
      const pageSize = 50;
      let resultRefs = [];
      let renderedCount = 0;
      let isRendering = false;

      if (input) {
        input.value = query;
      }

      const normalizeResultUrl = (url) => {
        try {
          const parsed = new URL(url, window.location.origin);
          if (parsed.origin !== window.location.origin) {
            return url;
          }

          const pathname = parsed.pathname === '/' ? '/' : parsed.pathname.replace(/\/+$/, '');
          return `${pathname}${parsed.search}${parsed.hash}`;
        } catch (error) {
          return url;
        }
      };

      const renderResult = (data) => {
        const article = document.createElement('article');
        article.className = 'search-result';

        const title = document.createElement('h2');
        const link = document.createElement('a');
        link.href = normalizeResultUrl(data.url);
        link.textContent = data.meta?.title || data.url;
        title.append(link);

        const excerpt = document.createElement('p');
        excerpt.className = 'muted';
        excerpt.innerHTML = data.excerpt || '';

        article.append(title, excerpt);
        return article;
      };

      const updateRenderedStatus = () => {
        status.textContent =
          renderedCount === resultRefs.length
            ? `${resultRefs.length} Treffer`
            : `${resultRefs.length} Treffer. ${renderedCount} angezeigt.`;
      };

      const renderNextResults = async () => {
        if (isRendering) {
          return;
        }

        isRendering = true;

        document.querySelector('#load-more-results')?.remove();
        const nextResults = resultRefs.slice(renderedCount, renderedCount + pageSize);
        status.textContent = `${resultRefs.length} Treffer gefunden. Treffer ${renderedCount + 1}-${renderedCount + nextResults.length} werden geladen ...`;

        try {
          const hydratedResults = await Promise.all(nextResults.map((result) => result.data()));
          const fragment = document.createDocumentFragment();
          hydratedResults.forEach((data) => fragment.append(renderResult(data)));
          results.append(fragment);
          renderedCount += hydratedResults.length;
          updateRenderedStatus();
        } catch (error) {
          status.textContent = 'Die Suchtreffer konnten nicht geladen werden.';
          isRendering = false;
          return;
        }

        if (renderedCount < resultRefs.length) {
          const button = document.createElement('button');
          button.id = 'load-more-results';
          button.className = 'button load-more';
          button.type = 'button';
          button.textContent = 'Weitere Treffer anzeigen';
          button.addEventListener('click', renderNextResults);
          results.after(button);
        }

        isRendering = false;
      };

      const runSearch = async () => {
        if (!query) {
          status.textContent = 'Bitte geben Sie eine Suchanfrage ein.';
          return;
        }

        status.textContent = 'Suchindex wird geladen ...';

        try {
          if (typeof window.fetch !== 'function') {
            throw new Error('Fetch API is required for Pagefind search.');
          }

          const pagefind = await Promise.race([
            import('/pagefind/pagefind.js'),
            new Promise((_, reject) => {
              window.setTimeout(() => reject(new Error('Pagefind loading timed out.')), 10000);
            }),
          ]);
          await pagefind.options({ excerptLength: 30 });
          status.textContent = 'Suchanfrage wird ausgeführt ...';
          const search = await pagefind.search(query);

          if (!search.results.length) {
            status.textContent = 'Ihre Suche lieferte keine Treffer.';
            return;
          }

          resultRefs = search.results;
          status.textContent = `${resultRefs.length} Treffer gefunden. Erste Treffer werden geladen ...`;
          await renderNextResults();
        } catch (error) {
          status.textContent = 'Der Suchindex konnte nicht geladen werden.';
        }
      };

      runSearch();
    })();
  </script>
</BaseLayout>
