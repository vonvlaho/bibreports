---
import AnalyticsTable from '../../../components/AnalyticsTable.astro';
import PageHeader from '../../../components/PageHeader.astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { people, relatedRowsForEntries } from '../../../lib/data';

export function getStaticPaths() {
  return people.map((person) => ({ params: { id: String(person.id) }, props: { person } }));
}

const { person } = Astro.props;
const entryIds = person.entries.map((entry) => entry.entryId);
const name = [person.givenName, person.familyName].filter(Boolean).join(' ');
---

<BaseLayout title={`Analyse ${name}`} searchable={false}>
  <PageHeader
    title={name}
    eyebrow="Analyse"
    description="Kombinationen dieser Person mit Registerbegriffen und Ortsverweisen nach Jahr."
    meta={[`${entryIds.length} verknüpfte Einträge`]}
  />
  <AnalyticsTable title="Registerbegriffe" rows={relatedRowsForEntries(entryIds, 'keywords')} headingLevel="h2" />
  <AnalyticsTable title="Publikationsorte" rows={relatedRowsForEntries(entryIds, 'places')} headingLevel="h2" />
</BaseLayout>
