---
import AnalyticsTable from '../../../components/AnalyticsTable.astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { places, relatedRowsForEntries } from '../../../lib/data';

export function getStaticPaths() {
  return places.map((place) => ({ params: { id: String(place.id) }, props: { place } }));
}

const { place } = Astro.props;
---

<BaseLayout title={`Analyse ${place.name}`} searchable={false}>
  <div class="container">
    <section class="section panel">
      <h1>{place.name}</h1>
    </section>
    <AnalyticsTable title="Schlagworte" rows={relatedRowsForEntries(place.entryIds, 'keywords')} headingLevel="h2" />
    <AnalyticsTable title="Personen" rows={relatedRowsForEntries(place.entryIds, 'people')} headingLevel="h2" />
  </div>
</BaseLayout>
