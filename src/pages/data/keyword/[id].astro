---
import AnalyticsTable from '../../../components/AnalyticsTable.astro';
import PageHeader from '../../../components/PageHeader.astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { keywords, relatedRowsForEntries } from '../../../lib/data';

export function getStaticPaths() {
  return keywords.map((keyword) => ({ params: { id: String(keyword.id) }, props: { keyword } }));
}

const { keyword } = Astro.props;
---

<BaseLayout title={`Analyse ${keyword.name}`} searchable={false}>
  <PageHeader
    title={keyword.name}
    eyebrow="Analyse"
    description="Kombinationen dieses Registerbegriffs mit Orts- und Personenverweisen nach Jahr."
    meta={[`${keyword.entryIds.length} verknüpfte Einträge`]}
  />
  <AnalyticsTable title="Orte" rows={relatedRowsForEntries(keyword.entryIds, 'places')} headingLevel="h2" />
  <AnalyticsTable title="Personen" rows={relatedRowsForEntries(keyword.entryIds, 'people')} headingLevel="h2" />
</BaseLayout>
