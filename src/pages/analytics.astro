---
import BaseLayout from '../layouts/BaseLayout.astro';
import CsvExports from '../components/CsvExports.astro';
import PageHeader from '../components/PageHeader.astro';
---

<BaseLayout title="Analyse">
  <PageHeader
    title="Analyse"
    eyebrow="Analyse"
    description="Jahresbezogene Auswertungen der Registerbegriffe, Personen und Publikationsorte."
  />
  <section class="container section link-list analysis-links">
    <a href="/data/keywords"><strong>Registerbegriffe</strong><span class="muted">Häufigkeiten pro Jahr</span></a>
    <a href="/data/people"><strong>Personen</strong><span class="muted">Häufigkeiten pro Jahr</span></a>
    <a href="/data/places"><strong>Publikationsorte</strong><span class="muted">Häufigkeiten pro Jahr</span></a>
  </section>
  <section class="container section">
    <h2>Datenexporte</h2>
    <CsvExports />
  </section>
</BaseLayout>
