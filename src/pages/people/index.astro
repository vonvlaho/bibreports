---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AlphabetNav from '../../components/AlphabetNav.astro';
import PageHeader from '../../components/PageHeader.astro';
import RegisterFilter from '../../components/RegisterFilter.astro';
import { people } from '../../lib/data';
import { createAnchorFactory, personDisplayName as displayName } from '../../lib/register';

const anchorFor = createAnchorFactory('people');
---

<BaseLayout title="Personenverzeichnis">
  <PageHeader
    title="Personenverzeichnis"
    description="Personen und Körperschaften mit verknüpften bibliographischen Einträgen."
    className="register-tools"
  >
    <RegisterFilter label="Personenverzeichnis durchsuchen" placeholder="Person" countLabel="Personen" />
    <AlphabetNav items={people} getLabel={(item: any) => displayName(item)} targetPrefix="people" />
  </PageHeader>
  <section class="container section content">
    <ul class="index-list">
      {
        people.map((person) => (
          <li id={anchorFor(displayName(person))} data-register-row data-register-text={`${person.familyName} ${person.givenName}`}>
            <a href={`/people/${person.id}`}>{person.familyName}{person.givenName && `, ${person.givenName}`}</a>
            <span class="muted">{person.entries.length}</span>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>
