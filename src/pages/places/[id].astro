---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import { groupEntriesByYear, places } from '../../lib/data';

export function getStaticPaths() {
  return places.map((place) => ({ params: { id: String(place.id) }, props: { place } }));
}

const { place } = Astro.props;
const groups = groupEntriesByYear(place.entryIds);
---

<BaseLayout title={place.name}>
  <PageHeader title={place.name} eyebrow="Publikationsort" meta={[`${place.entryIds.length} verknüpfte Einträge`]} />
  <section class="container section">
    {groups.map((group) => (
      <section class="year-group">
        <h2>{group.year}</h2>
        <ul class="list">
          {group.entries.map((entry) => <li><a href={`/entries/${entry.id}/`}>{entry.fullTitle}</a></li>)}
        </ul>
      </section>
    ))}
  </section>
</BaseLayout>
