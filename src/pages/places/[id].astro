---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { groupEntriesByYear, places } from '../../lib/data';

export function getStaticPaths() {
  return places.map((place) => ({ params: { id: String(place.id) }, props: { place } }));
}

const { place } = Astro.props;
const groups = groupEntriesByYear(place.entryIds);
---

<BaseLayout title={place.name}>
  <section class="container section panel">
    <h1>{place.name}</h1>
    <p class="muted">{place.entryIds.length} verknüpfte Einträge</p>
  </section>
  <section class="container section">
    {groups.map((group) => (
      <section class="section">
        <h2>{group.year}</h2>
        <ul class="list">
          {group.entries.map((entry) => <li><a href={`/entries/${entry.id}/`}>{entry.fullTitle}</a></li>)}
        </ul>
      </section>
    ))}
  </section>
</BaseLayout>
