---
import '../styles/global.css';

type Props = {
  title?: string;
  description?: string;
  isHome?: boolean;
  searchable?: boolean;
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
};

const {
  title = 'Musikwissenschaftliche Forschung in der DDR 1966–1975',
  description = 'Digitale Reproduktion der Berichte über die musikwissenschaftlichen Arbeiten in der Deutschen Demokratischen Republik.',
  isHome = false,
  searchable = true,
  structuredData,
} = Astro.props;

const appName = 'Musikwissenschaft in der DDR';
const pageTitle = isHome ? title : `${title} | ${appName}`;
const siteUrl = 'https://musikwissenschaft-ddr.de';
const normalizePath = (pathname: string) => (pathname === '/' ? '/' : pathname.replace(/\/+$/, ''));
const canonicalUrl = new URL(normalizePath(Astro.url.pathname), siteUrl).toString();
const structuredDataItems = structuredData ? (Array.isArray(structuredData) ? structuredData : [structuredData]) : [];
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <title>{pageTitle}</title>
    {structuredDataItems.map((item) => <script is:inline type="application/ld+json" set:html={JSON.stringify(item)} />)}
  </head>
  <body>
    <header class="site-header">
      <nav class="nav" aria-label="Hauptnavigation">
        <a class="brand" href="/">
          <span>{appName}</span>
          <small>1966–1975</small>
        </a>
        <div class="nav-links">
          <a href="/reports">Berichte</a>
          <a href="/keywords">Register</a>
          <a href="/places">Publikationsorte</a>
          <a href="/people">Personenverzeichnis</a>
          <a href="/analytics">Analyse</a>
          <a href="/about-data">Daten</a>
        </div>
      </nav>
    </header>
    <main data-pagefind-body={searchable ? true : undefined}>
      <slot />
    </main>
    <footer class="site-footer">
      <div class="container">
        <span>Frederic von Vlahovits, {appName}, 1966–1975</span>
        <span>Daten <a href="https://creativecommons.org/licenses/by/4.0/">CC BY 4.0</a>, Code MIT</span>
        <a href="/about-data">Daten und Zitation</a>
        <a href="https://doi.org/10.3726/b23614">Buch zum Projekt (Open Access)</a>
        <a href="https://github.com/vonvlaho/bibreports">GitHub</a>
      </div>
    </footer>
  </body>
</html>
