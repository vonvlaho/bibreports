---
import '../styles/global.css';

type Props = {
  title?: string;
  description?: string;
  isHome?: boolean;
  searchable?: boolean;
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
};

const {
  title = 'Musikwissenschaftliche Forschung in der DDR 1966–1975',
  description = 'Digitale Reproduktion der Berichte über die musikwissenschaftlichen Arbeiten in der Deutschen Demokratischen Republik.',
  isHome = false,
  searchable = true,
  structuredData,
} = Astro.props;

const appName = 'Musikwissenschaft in der DDR';
const pageTitle = isHome ? title : `${title} | ${appName}`;
const siteUrl = 'https://musikwissenschaft-ddr.de';
const normalizePath = (pathname: string) => (pathname === '/' ? '/' : pathname.replace(/\/+$/, ''));
const canonicalUrl = new URL(normalizePath(Astro.url.pathname), siteUrl).toString();
const structuredDataItems = structuredData ? (Array.isArray(structuredData) ? structuredData : [structuredData]) : [];
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <title>{pageTitle}</title>
    {structuredDataItems.map((item) => <script is:inline type="application/ld+json" set:html={JSON.stringify(item)} />)}
  </head>
  <body>
    <header class:list={['site-header', { home: isHome }]}>
      {
        isHome ? (
          <div class="hero">
            <p class="app-label">{appName}</p>
            <h1>Musikwissenschaftliche Forschung in der DDR 1966–1975</h1>
            <p>
              Digitale Reproduktion der <a href="/reports"><em>Berichte über die musikwissenschaftlichen Arbeiten in der Deutschen Demokratischen Republik</em></a>.
            </p>
          </div>
        ) : (
          <nav class="nav" aria-label="Hauptnavigation">
            <a class="brand" href="/">
              <span>{appName}</span>
              <small>1966–1975</small>
            </a>
            <div class="nav-links">
              <a href="/reports">Übersicht</a>
              <a href="/keywords">Register</a>
              <a href="/places">Publikationsorte</a>
              <a href="/people">Personenverzeichnis</a>
              <a href="/analytics">Analyse</a>
              <a href="/about-data">Daten</a>
              <a href="/#Hintergrund">Hintergrund</a>
            </div>
          </nav>
        )
      }
    </header>
    <main data-pagefind-body={searchable ? true : undefined}>
      <slot />
    </main>
  </body>
</html>
