---
type Props = {
  placeholder?: string;
  value?: string;
};

const { placeholder = 'Suchanfrage', value = '' } = Astro.props;
---

<form class="search" action="/search/" method="get">
  <input type="search" name="search" value={value} placeholder={placeholder} />
  <button class="button" type="submit">Search</button>
</form>
