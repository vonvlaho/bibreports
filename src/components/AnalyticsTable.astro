---
import type { AnalyticsRow } from '../lib/data';
import { years } from '../lib/data';

type Props = {
  title: string;
  rows: AnalyticsRow[];
  basePath?: string;
  headingLevel?: 'h1' | 'h2';
};

const { title, rows, basePath, headingLevel = 'h1' } = Astro.props;
const Heading = headingLevel;
---

<section class="section">
  <Heading>{title}</Heading>
  <div class="table-wrap">
    <table>
      <thead>
        <tr>
          <th>{title}</th>
          {years.map((year) => <th>{year}</th>)}
          <th>Summe</th>
        </tr>
      </thead>
      <tbody>
        {
          rows.map((row) => (
            <tr>
              <td>{basePath ? <a href={`${basePath}/${row.id}/`}>{row.name}</a> : row.name}</td>
              {years.map((year) => <td>{row.years[year] ?? 0}</td>)}
              <td>{row.total}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
</section>
