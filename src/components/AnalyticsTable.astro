---
import PageHeader from './PageHeader.astro';
import type { AnalyticsRow } from '../lib/data';
import { years } from '../lib/data';

type Props = {
  title: string;
  rows: AnalyticsRow[];
  basePath?: string;
  description?: string;
  headingLevel?: 'h1' | 'h2';
};

const { title, rows, basePath, description, headingLevel = 'h1' } = Astro.props;
const isPrimary = headingLevel === 'h1';
---

{
  isPrimary && (
    <PageHeader title={title} eyebrow="Analyse" description={description} meta={[`${rows.length} Zeilen`]} />
  )
}

<section class="container section analytics-table-section">
  {
    !isPrimary && (
      <div class="table-heading">
        <h2>{title}</h2>
        {description && <p class="muted">{description}</p>}
        <p class="muted">{rows.length} Zeilen</p>
      </div>
    )
  }
  <div class="table-wrap">
    <table class="analytics-table">
      <thead>
        <tr>
          <th>{title}</th>
          {years.map((year) => <th>{year}</th>)}
          <th>Summe</th>
        </tr>
      </thead>
      <tbody>
        {
          rows.map((row) => (
            <tr>
              <td>{basePath ? <a href={`${basePath}/${row.id}/`}>{row.name}</a> : row.name}</td>
              {years.map((year) => <td>{row.years[year] ?? 0}</td>)}
              <td class="sum">{row.total}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
</section>
